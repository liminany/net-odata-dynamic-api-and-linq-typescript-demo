<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <!-- 使用本地 DLL 引用（绕过 NuGet 沙箱限制） -->
  <ItemGroup>
    <Reference Include="Microsoft.AspNetCore.OData">
      <HintPath>..\packages\microsoft.aspnetcore.odata.9.0.0\lib\net8.0\Microsoft.AspNetCore.OData.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.OData.Core">
      <HintPath>..\packages\microsoft.odata.core.8.0.2\lib\net8.0\Microsoft.OData.Core.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.OData.Edm">
      <HintPath>..\packages\microsoft.odata.edm.8.0.2\lib\net8.0\Microsoft.OData.Edm.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.OData.ModelBuilder">
      <HintPath>..\packages\microsoft.odata.modelbuilder.2.0.0\lib\net8.0\Microsoft.OData.ModelBuilder.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Spatial">
      <HintPath>..\packages\microsoft.spatial.8.0.2\lib\net8.0\Microsoft.Spatial.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="datasources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\customers.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\orders.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\products.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
