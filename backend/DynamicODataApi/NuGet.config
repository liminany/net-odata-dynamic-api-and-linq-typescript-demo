<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value="..\.nuget" />
    <!-- <add key="globalPackagesFolder" value="D:\Admin\Documents" />
    <add key="http-cache" value="D:\Admin\Documents" /> -->
  </config>
</configuration>
